---
import { projectHref } from "../../data/projects.js";
const {
  title, nature, sector, year, status, excerpt, notice, theme = "charcoal",
  details = [], coverImage, coverAlt, coverPosition, coverFit = "contain",
  coverAspectRatio = "4 / 3", actionLabel = "Ver projeto", variant = "default",
} = Astro.props;
const href = projectHref(Astro.props);
const Tag = href ? "a" : "div";
const hasCover = Boolean(coverImage);
const [coverWidth, coverHeight] = coverAspectRatio.split("/").map(Number);
const isLandscapeCover = coverWidth > coverHeight;
---
<article class:list={["project-card", `project-card--${theme}`, `project-card--${variant}`]}>
  <Tag href={href} class="project-card__link">
    {hasCover && <div class="project-card__visual">
      <div class:list={["project-card__media", {"project-card__media--landscape": isLandscapeCover}]} style={{aspectRatio: coverAspectRatio}}>
        <img src={coverImage} alt={coverAlt ?? title} class="project-card__image" loading="lazy" decoding="async" style={{objectFit:coverFit,objectPosition:coverPosition ?? "center"}} />
      </div>
    </div>}
    <div class="project-card__content">
      <div class="project-card__meta"><span>{nature}</span>{year && <span>{year}</span>}</div>
      <h3 class="project-card__title">{title}</h3>
      <dl class="project-card__facts">
        <div><dt>Setor</dt><dd>{sector}</dd></div>
        <div><dt>Estado</dt><dd>{status}</dd></div>
      </dl>
      <p class="project-card__description">{excerpt}</p>
      {notice && <p class="project-card__notice">{notice}</p>}
      {details.length > 0 && <dl class="project-card__details">{details.map((detail) => <div><dt>{detail.label}</dt><dd>{detail.text}</dd></div>)}</dl>}
      {href && <span class="project-card__action">{actionLabel}<span aria-hidden="true">↗</span></span>}
    </div>
  </Tag>
</article>
<style>
  .project-card {
    min-width: 0;
  }

  .project-card__link {
    display: block;
    color: inherit;
  }

  .project-card__visual {
    position: relative;

    display: flex;
    align-items: center;
    justify-content: center;

    aspect-ratio: 16 / 10;

    margin-bottom: var(--space-6);

    border: 1px solid var(--color-border);
    border-radius: var(--radius-xl);

    overflow: hidden;
  }

  .project-card--slate .project-card__visual {
    background:
      linear-gradient(
        145deg,
        rgba(111, 130, 157, 0.3),
        rgba(24, 27, 31, 1)
      );
  }

  .project-card--stone .project-card__visual {
    background:
      linear-gradient(
        145deg,
        rgba(181, 180, 175, 0.18),
        rgba(24, 27, 31, 1)
      );
  }

  .project-card--charcoal .project-card__visual {
    background:
      linear-gradient(
        145deg,
        rgba(242, 240, 235, 0.08),
        rgba(17, 19, 21, 1)
      );
  }

  .project-card__mockup,
  .project-card__media {
    display: flex;
    align-items: center;
    justify-content: center;

    width: min(320px, 72%);
    aspect-ratio: 4 / 5;

    border: 1px solid var(--color-border-hover);
    border-radius: var(--radius-lg);

    background: rgba(17, 19, 21, 0.55);

    box-shadow: var(--shadow-soft);

    overflow: hidden;

    transition:
      transform 500ms cubic-bezier(0.2, 0.8, 0.2, 1);
  }

  .project-card__media--landscape {
    width: min(520px, 78%);
  }

  .project-card__mockup {
    padding: var(--space-6);
  }

  .project-card__mockup span {
    color: var(--color-text-primary);

    font-size: clamp(1.5rem, 3vw, 2.6rem);
    font-weight: 600;

    letter-spacing: -0.04em;
    text-align: center;
  }

  .project-card__image {
    display: block;

    width: 100%;
    height: 100%;

    object-fit: cover;
  }

  .project-card__status {
    position: absolute;
    top: var(--space-4);
    right: var(--space-4);

    padding: 7px 11px;

    border: 1px solid var(--color-border);
    border-radius: 999px;

    background: rgba(17, 19, 21, 0.72);

    backdrop-filter: blur(10px);

    color: var(--color-text-secondary);

    font-size: 0.72rem;
    font-weight: 500;
  }

  .project-card__meta {
    display: flex;
    justify-content: space-between;
    gap: var(--space-4);

    margin-bottom: var(--space-4);

    color: var(--color-text-muted);

    font-size: 0.75rem;
    font-weight: 600;

    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .project-card__title {
    margin-bottom: var(--space-4);

    font-size: clamp(1.7rem, 2.5vw, 2.4rem);
    font-weight: 500;
  }

  .project-card__description {
    max-width: 620px;

    margin-bottom: var(--space-5);

    color: var(--color-text-secondary);
  }

  .project-card__mockup--pending {
    width: min(520px, 78%);
    aspect-ratio: 36 / 25;
  }

  .project-card__mockup--pending span {
    font-size: clamp(1.15rem, 2vw, 1.6rem);
  }

  .project-card__details {
    display: grid;
    gap: var(--space-4);
    margin: 0 0 var(--space-6);
  }

  .project-card__details dt {
    color: var(--color-text-primary);
    font-size: 0.8rem;
    font-weight: 600;
  }

  .project-card__details dd {
    margin: var(--space-1) 0 0;
    color: var(--color-text-secondary);
    font-size: 0.95rem;
  }

  .project-card__action {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);

    color: var(--color-text-primary);

    font-size: 0.9rem;
    font-weight: 500;
  }

  .project-card__action span {
    transition: transform var(--transition-fast);
  }

  .project-card__link:hover .project-card__mockup,
  .project-card__link:hover .project-card__media {
    transform: scale(1.025);
  }

  .project-card__link:hover .project-card__action span {
    transform: translate(2px, -2px);
  }

  .project-card__link:focus-visible {
    outline: 2px solid var(--color-primary-hover);
    outline-offset: 8px;
    border-radius: var(--radius-lg);
  }

  @media (max-width: 640px) {
    .project-card__mockup,
    .project-card__media:not(.project-card__media--landscape) {
      width: min(280px, 78%);
    }
  }

  .project-card__meta { flex-wrap: wrap; color: var(--color-text-secondary); }
  .project-card__facts { display: grid; gap: 0.75rem; margin: 0 0 1.5rem; }
  .project-card__facts div { display: grid; grid-template-columns: 3.5rem minmax(0, 1fr); gap: 0.75rem; }
  .project-card__facts dt { font-size: 0.8rem; color: var(--color-text-secondary); }
  .project-card__facts dd { margin: 0; font-size: 0.95rem; color: var(--color-text-primary); }
  .project-card__notice { padding-left: 1rem; border-left: 2px solid var(--color-primary); color: var(--color-text-secondary); font-size: 0.95rem; }
  .project-card__content { min-width: 0; }
  .project-card__title { overflow-wrap: anywhere; }
  .project-card--primary .project-card__link { display: grid; grid-template-columns: minmax(0, 1.35fr) minmax(0, 1fr); gap: clamp(2rem, 4vw, 4rem); align-items: center; }
  .project-card--primary .project-card__visual { margin-bottom: 0; }
  .project-card--primary .project-card__media { width: 92%; }
  .project-card--planned { padding: clamp(1.5rem, 3vw, 3rem); border: 1px solid var(--color-border); border-radius: var(--radius-xl); }
  .project-card--planned .project-card__title { font-size: clamp(1.5rem, 2.5vw, 2.2rem); }
  @media (max-width: 900px) {
    .project-card--primary .project-card__link { grid-template-columns: 1fr; }
  }
</style>