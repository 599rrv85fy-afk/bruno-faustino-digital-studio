---
import { preventIndexing } from "../../utils/indexing";

const {
  title = "Bruno Faustino Digital Studio",
  description = "Estratégia, tecnologia e soluções digitais para negócios mais fortes.",
  canonical,
  image = "/social/og-default.jpg",
  imageWidth = image === "/social/og-default.jpg" ? 1200 : undefined,
  imageHeight = image === "/social/og-default.jpg" ? 630 : undefined,
  imageType = image === "/social/og-default.jpg" ? "image/jpeg" : undefined,
  imageAlt = "Bruno Faustino Digital Studio — Negócios mais fortes no mundo digital.",
  type = "website",
  noindex = false,
} = Astro.props;

const brandName = "Bruno Faustino Digital Studio";

// Use the same configured origin as the sitemap and robots.txt.
const siteURL = Astro.site ?? null;

const canonicalURL = canonical
  ? siteURL
    ? new URL(canonical, siteURL)
    : new URL(canonical, Astro.url.origin)
  : siteURL
    ? new URL(Astro.url.pathname, siteURL)
    : null;

const imageURL = image
  ? siteURL
    ? new URL(image, siteURL)
    : new URL(image, Astro.url.origin)
  : null;

const robotsContent =
  noindex || preventIndexing
    ? "noindex, nofollow"
    : "index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1";

const isHomepage = Astro.url.pathname === "/";

const websiteSchema =
  isHomepage && siteURL
    ? {
        "@context": "https://schema.org",
        "@type": "WebSite",
        name: brandName,
        url: siteURL.toString(),
        inLanguage: "pt-PT",
        description,
      }
    : null;
---

<title>{title}</title>

<meta
  name="description"
  content={description}
/>

<meta
  name="robots"
  content={robotsContent}
/>

<meta
  name="googlebot"
  content={robotsContent}
/>

<meta
  name="theme-color"
  content="#111315"
/>

<meta
  name="color-scheme"
  content="dark"
/>

{
  canonicalURL && (
    <link
      rel="canonical"
      href={canonicalURL.toString()}
    />
  )
}

<meta
  property="og:type"
  content={type}
/>

<meta
  property="og:site_name"
  content={brandName}
/>

<meta
  property="og:title"
  content={title}
/>

<meta
  property="og:description"
  content={description}
/>

<meta
  property="og:locale"
  content="pt_PT"
/>

{
  canonicalURL && (
    <meta
      property="og:url"
      content={canonicalURL.toString()}
    />
  )
}

{
  imageURL && (
    <>
      <meta
        property="og:image"
        content={imageURL.toString()}
      />

      {imageWidth && <meta property="og:image:width" content={String(imageWidth)} />}
      {imageHeight && <meta property="og:image:height" content={String(imageHeight)} />}
      {imageType && <meta property="og:image:type" content={imageType} />}

      <meta
        property="og:image:alt"
        content={imageAlt}
      />
    </>
  )
}

<meta
  name="twitter:card"
  content="summary_large_image"
/>

<meta
  name="twitter:title"
  content={title}
/>

<meta
  name="twitter:description"
  content={description}
/>

{
  imageURL && (
    <>
      <meta
        name="twitter:image"
        content={imageURL.toString()}
      />

      <meta
        name="twitter:image:alt"
        content={imageAlt}
      />
    </>
  )
}

{
  websiteSchema && (
    <script
      type="application/ld+json"
      set:html={JSON.stringify(websiteSchema)}
    />
  )
}