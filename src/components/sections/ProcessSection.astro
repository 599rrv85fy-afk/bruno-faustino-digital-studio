---
import ProcessStep from "../process/ProcessStep.astro";
import { processSteps } from "../../data/process.js";
---

<section class="process-section">
  <div class="container">

    <div class="process-section__header">
      <div>
        <p class="process-section__eyebrow">
          Processo
        </p>

        <h2>
          Do problema à solução, com um processo claro.
        </h2>
      </div>

      <p class="process-section__intro">
        Cada projeto começa pela compreensão do contexto e evolui
        através de decisões estruturadas, execução cuidada e melhoria
        contínua.
      </p>
    </div>

    <div class="process-section__steps">
      {
        processSteps.map((step) => (
          <ProcessStep {...step} />
        ))
      }
    </div>

  </div>
</section>

<style>
  .process-section {
    background: var(--color-bg-primary);
  }

  .process-section__header {
    display: grid;
    grid-template-columns:
      minmax(0, 1.1fr)
      minmax(300px, 0.9fr);

    align-items: end;

    gap: clamp(48px, 8vw, 120px);

    margin-bottom: var(--space-9);
  }

  .process-section__eyebrow {
    margin-bottom: var(--space-5);

    color: var(--color-primary);

    font-size: 0.75rem;
    font-weight: 600;

    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .process-section__header h2 {
    max-width: 820px;

    margin-bottom: 0;
  }

  .process-section__intro {
    max-width: 560px;

    margin-bottom: 0;

    color: var(--color-text-secondary);

    font-size: 1.05rem;
    line-height: 1.7;
  }

  .process-section__steps {
    min-width: 0;
  }

  @media (max-width: 900px) {
    .process-section__header {
      grid-template-columns: 1fr;

      gap: var(--space-5);

      margin-bottom: var(--space-8);
    }
  }
</style>