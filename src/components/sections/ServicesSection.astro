---
import Button from "../ui/Button.astro";

import SectionHeader
  from "../ui/SectionHeader.astro";

import ServiceCard
  from "../services/ServiceCard.astro";

import { services }
  from "../../data/services.js";
---

<section class="services-section">
  <div class="container">

    <SectionHeader
      eyebrow="Serviços"
      title="Soluções digitais pensadas para necessidades reais."
      description="Da presença digital à automação e evolução contínua, cada solução parte do que o negócio realmente precisa."
    />

    <div class="services-section__list">
      {
        services.map((service) => (
          <ServiceCard {...service} />
        ))
      }
    </div>

    <div class="services-section__action">
      <Button href="/servicos" variant="secondary">Ver serviços</Button>
    </div>
  </div>
</section>

<style>
  .services-section {
    background:
      var(--color-bg-secondary);
  }

  .services-section__list {
    width: 100%;
  }
  .services-section__action {
    margin-top: var(--space-7);
  }
</style>