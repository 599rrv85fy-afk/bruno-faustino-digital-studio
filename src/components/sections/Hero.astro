---
import Button from "../ui/Button.astro";
---

<section class="hero">
  <div class="container hero__inner">
    <div class="hero__content">
      <p class="hero__eyebrow">
        Build better. Grow smarter.
      </p>

      <p class="hero__brand-line">Negócios mais fortes no mundo digital.</p>

      <h1 class="hero__title">
        Presença digital mais forte. Tecnologia que simplifica o negócio.
      </h1>

      <p class="hero__description">
        Ajudo profissionais independentes e pequenas empresas a melhorar websites, processos digitais e utilização de tecnologia.
      </p>

      <div class="hero__actions">
        <Button href="/contactos">
          Falar sobre um projeto
        </Button>

        <Button href="/projetos" variant="secondary">
          Ver projetos
        </Button>
      </div>
    </div>
  </div>
</section>

<style>
  .hero {
    display: flex;
    align-items: center;

    min-height: calc(100svh - 80px);

    padding-block: clamp(96px, 10vw, 144px);

    background-color: var(--color-bg-primary);
    background-image:
      linear-gradient(
        90deg,
        rgba(15, 17, 21, 0.98) 0%,
        rgba(15, 17, 21, 0.94) 30%,
        rgba(15, 17, 21, 0.78) 50%,
        rgba(15, 17, 21, 0.34) 72%,
        rgba(15, 17, 21, 0.12) 100%
      ),
      linear-gradient(
        180deg,
        rgba(15, 17, 21, 0.12) 0%,
        rgba(15, 17, 21, 0.08) 60%,
        rgba(15, 17, 21, 0.4) 100%
      ),
      url("/images/hero/bruno-faustino-digital-studio-hero-wide.webp");

    background-repeat: no-repeat;
    background-position: center;
    background-size: cover;

    overflow: hidden;
  }

  .hero__content {
    max-width: 900px;
  }

  .hero__eyebrow {
    margin-bottom: var(--space-6);

    color: var(--color-primary);

    font-size: 0.75rem;
    font-weight: 600;

    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .hero__brand-line {
    margin-bottom: var(--space-5);
    color: var(--color-text-secondary);
    font-size: 1rem;
  }

  .hero__title {
    max-width: 900px;

    margin-bottom: var(--space-7);

    font-size: clamp(2.8rem, 4.3vw, 4.5rem);
    line-height: 1.06;
    text-wrap: balance;

    letter-spacing: -0.055em;
  }

  .hero__description {
    max-width: 700px;

    margin-bottom: var(--space-7);

    color: var(--color-text-secondary);

    font-size: clamp(1.1rem, 1.6vw, 1.35rem);
    line-height: 1.6;
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;

    gap: var(--space-4);
  }

  @media (max-width: 1100px) {
    .hero {
      background-image:
        linear-gradient(
          90deg,
          rgba(15, 17, 21, 0.98) 0%,
          rgba(15, 17, 21, 0.94) 42%,
          rgba(15, 17, 21, 0.68) 72%,
          rgba(15, 17, 21, 0.38) 100%
        ),
        linear-gradient(
          180deg,
          rgba(15, 17, 21, 0.18) 0%,
          rgba(15, 17, 21, 0.16) 60%,
          rgba(15, 17, 21, 0.5) 100%
        ),
        url("/images/hero/bruno-faustino-digital-studio-hero-wide.webp");

      background-position: 62% center;
    }

    .hero__content,
    .hero__title {
      max-width: 780px;
    }
  }

  @media (max-width: 768px) {
    .hero {
      min-height: calc(100svh - 72px);

      padding-block: 88px 80px;

      background-image:
        linear-gradient(
          90deg,
          rgba(15, 17, 21, 0.96) 0%,
          rgba(15, 17, 21, 0.88) 100%
        ),
        linear-gradient(
          180deg,
          rgba(15, 17, 21, 0.16) 0%,
          rgba(15, 17, 21, 0.3) 55%,
          rgba(15, 17, 21, 0.72) 100%
        ),
        url("/images/hero/bruno-faustino-digital-studio-hero-wide.webp");

      background-position: 70% center;
    }

    .hero__title {
      font-size: clamp(2.1rem, 8vw, 3.6rem);
    }

    .hero__description {
      font-size: 1.05rem;
    }

    .hero__actions {
      flex-direction: column;
      align-items: stretch;
    }
  }
</style>