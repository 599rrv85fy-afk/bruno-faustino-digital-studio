---
import Button from "../ui/Button.astro";
---

<section class="about-preview">
  <div class="container about-preview__grid">
    <div class="about-preview__visual">
      <figure class="about-preview__image">
        <img
          src="/images/profile/bruno-faustino-about.webp"
          alt="Bruno Faustino, fundador da Bruno Faustino Digital Studio"
          class="about-preview__portrait"
          width="1122"
          height="1402"
          loading="lazy"
          decoding="async"
        />

        <figcaption>
          Bruno Faustino · Digital Studio
        </figcaption>
      </figure>
    </div>

    <div class="about-preview__content">
      <p class="about-preview__eyebrow">
        Sobre
      </p>

      <h2 class="about-preview__title">
        Tecnologia com contexto de negócio.
      </h2>

      <p class="about-preview__lead">
        Bruno Faustino, responsável pela Bruno Faustino Digital Studio, acompanha diretamente cada projeto, desde a compreensão do problema até à construção da solução.
      </p>

      <p>
        A experiência de gestão trouxe uma visão prática sobre operação, prioridades e clientes — uma perspetiva que hoje aplico ao trabalho digital.
      </p>

      <div class="about-preview__action">
        <Button href="/sobre" variant="secondary">
          Conhecer o percurso
        </Button>
      </div>
    </div>
  </div>
</section>

<style>
  .about-preview {
    background: var(--color-bg-secondary);
  }

  .about-preview__grid {
    display: grid;
    grid-template-columns:
      minmax(320px, 0.85fr)
      minmax(0, 1.15fr);

    align-items: center;

    gap: clamp(64px, 10vw, 140px);
  }

  .about-preview__visual {
    min-width: 0;
  }

  .about-preview__image {
    position: relative;

    aspect-ratio: 4 / 5;

    margin: 0;

    border: 1px solid var(--color-border);
    border-radius: var(--radius-xl);

    background: var(--color-bg-primary);
    box-shadow: var(--shadow-soft);

    overflow: hidden;
  }

  .about-preview__image::after {
    content: "";

    position: absolute;
    inset: 0;

    background:
      linear-gradient(
        180deg,
        rgba(15, 17, 21, 0) 58%,
        rgba(15, 17, 21, 0.72) 100%
      );

    pointer-events: none;
  }

  .about-preview__portrait {
    display: block;

    width: 100%;
    height: 100%;

    object-fit: cover;
    object-position: center 28%;
  }

  .about-preview__image figcaption {
    position: absolute;
    z-index: 1;
    right: var(--space-6);
    bottom: var(--space-6);
    left: var(--space-6);

    color: rgba(248, 247, 244, 0.76);

    font-size: 0.75rem;
    font-weight: 600;

    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .about-preview__eyebrow {
    margin-bottom: var(--space-6);

    color: var(--color-primary);

    font-size: 0.75rem;
    font-weight: 600;

    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .about-preview__title {
    max-width: 820px;

    margin-bottom: var(--space-7);
  }

  .about-preview__lead {
    color: var(--color-text-primary);

    font-size: clamp(1.25rem, 2vw, 1.55rem);
    line-height: 1.55;
  }

  .about-preview__content > p {
    max-width: 680px;

    margin-bottom: var(--space-5);
  }

  .about-preview__action {
    margin-top: var(--space-7);
  }

  @media (max-width: 900px) {
    .about-preview__grid {
      grid-template-columns: 1fr;

      gap: var(--space-8);
    }

    .about-preview__visual {
      max-width: 560px;
    }

    .about-preview__image {
      aspect-ratio: 16 / 11;
    }

    .about-preview__portrait {
      object-position: center 24%;
    }
  }

  @media (max-width: 640px) {
    .about-preview__image {
      aspect-ratio: 4 / 3;
    }

    .about-preview__image figcaption {
      right: var(--space-5);
      bottom: var(--space-5);
      left: var(--space-5);
    }
  }
</style>