---
import SectionHeader from "../ui/SectionHeader.astro";
import ProjectCard from "../projects/ProjectCard.astro";
import { projects } from "../../data/projects.js";

const featuredProjects = projects.filter((project) => project.featured);
---

<section class="featured-projects">
  <div class="container">

    <SectionHeader
      eyebrow="Projetos"
      title="Trabalho pensado para criar impacto real."
      description="Uma seleção de projetos reais e conceptuais que demonstram estratégia, design, desenvolvimento e evolução digital."
    />

    <div class="featured-projects__grid">
      {
        featuredProjects.map((project) => (
          <ProjectCard {...project} />
        ))
      }
    </div>

    <div class="featured-projects__footer">
      <a
        href="/projetos"
        class="featured-projects__all"
      >
        Ver todos os projetos
        <span aria-hidden="true">↗</span>
      </a>
    </div>

  </div>
</section>

<style>
  .featured-projects {
    background: var(--color-bg-secondary);
  }

  .featured-projects__grid {
    display: grid;

    grid-template-columns:
      repeat(2, minmax(0, 1fr));

    gap:
      var(--space-9)
      var(--space-7);
  }

  .featured-projects__grid > :nth-child(3) {
    grid-column: 1 / -1;

    width: 100%;
  }

  .featured-projects__footer {
    display: flex;
    justify-content: flex-end;

    margin-top: var(--space-9);

    padding-top: var(--space-6);

    border-top:
      1px solid var(--color-border);
  }

  .featured-projects__all {
    display: inline-flex;
    align-items: center;

    gap: var(--space-2);

    color: var(--color-text-primary);

    font-size: 0.95rem;
    font-weight: 500;
  }

  .featured-projects__all span {
    transition:
      transform var(--transition-fast);
  }

  .featured-projects__all:hover span {
    transform:
      translate(2px, -2px);
  }

  .featured-projects__all:focus-visible {
    outline: 2px solid var(--color-primary-hover);
    outline-offset: 4px;
  }

  @media (max-width: 900px) {
    .featured-projects__grid {
      grid-template-columns: 1fr;

      gap: var(--space-8);
    }

    .featured-projects__grid > :nth-child(3) {
      grid-column: auto;

      width: 100%;
    }

    .featured-projects__footer {
      justify-content: flex-start;
    }
  }
</style>