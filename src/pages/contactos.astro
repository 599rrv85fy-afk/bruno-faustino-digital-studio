---
import BaseLayout from "../layouts/BaseLayout.astro";

// WhatsApp Business profissional confirmado.
const whatsappUrl = "https://wa.me/351915796327";
const areas = [
  ["Web", "criação ou renovação de websites"],
  ["Automation & AI", "automação, integrações e IA"],
  ["Growth", "otimização de ativos digitais existentes"],
  ["Care", "manutenção e acompanhamento"],
  ["Outro / Ainda não sei", "ajuda a enquadrar a necessidade"],
];
const steps = [
  ["Leitura do pedido", "Percebo a necessidade e faço uma avaliação inicial do enquadramento."],
  ["Conversa", "Se fizer sentido avançar, marcamos uma conversa para aprofundar o contexto e as prioridades."],
  ["Próximo passo", "Quando aplicável, definimos proposta, âmbito e condições antes de iniciar o trabalho."],
];
---

<BaseLayout
  title="Contactos — Bruno Faustino Digital Studio"
  description="Fale sobre o seu projeto, desafio ou objetivo digital com a Bruno Faustino Digital Studio."
>
  <section class="contact-main" aria-labelledby="contact-title">
    <div class="container contact-main__grid">
      <div class="contact-opening">
        <p class="contact-eyebrow">Contactos</p>
        <h1 id="contact-title">Vamos falar sobre o seu projeto.</h1>
        <p class="contact-opening__lead">Tem um projeto em mente, algo que precisa de melhorar ou simplesmente uma necessidade digital que ainda não sabe como resolver? Envie-me uma breve descrição e eu próprio analisarei o pedido.</p>
      </div>

      <form
        id="formulario"
        class="contact-form"
        aria-label="Pedido de contacto"
        tabindex="-1"
        name="contacto"
        method="POST"
        action="/obrigado"
        data-netlify="true"
        netlify-honeypot="website"
      >
        <input type="hidden" name="form-name" value="contacto" />
        <div class="contact-form__honeypot" aria-hidden="true">
          <label for="website">Não preencher este campo</label>
          <input type="text" id="website" name="website" tabindex="-1" autocomplete="off" />
        </div>

        <p class="contact-form__hint">Os campos assinalados com * são obrigatórios.</p>
        <div class="contact-form__row">
          <div class="contact-form__field">
            <label for="nome">Nome *</label>
            <input type="text" id="nome" name="nome" autocomplete="name" required />
          </div>
          <div class="contact-form__field">
            <label for="empresa">Empresa ou negócio <span>Opcional</span></label>
            <input type="text" id="empresa" name="empresa" autocomplete="organization" />
          </div>
        </div>
        <div class="contact-form__field">
          <label for="email">Email *</label>
          <input type="email" id="email" name="email" autocomplete="email" required />
        </div>
        <div class="contact-form__field">
          <label for="tipo-projeto">Em que área pensa precisar de ajuda? <span>Opcional</span></label>
          <select id="tipo-projeto" name="tipo-projeto" aria-describedby="area-help">
            <option value="" selected>Selecione uma opção (opcional)</option>
            {areas.map(([value, description]) => <option value={value}>{value} — {description}</option>)}
          </select>
          <p id="area-help" class="contact-form__hint">Se não souber, pode deixar em branco ou escolher “Outro / Ainda não sei”.</p>
        </div>
        <div class="contact-form__field">
          <label for="mensagem">Conte-me brevemente o que precisa de melhorar ou resolver. *</label>
          <textarea id="mensagem" name="mensagem" rows="6" placeholder="Contexto, problema, objetivo ou ideia — não precisa de ter tudo definido." required></textarea>
        </div>
        <p class="contact-form__privacy">Os dados enviados serão utilizados apenas para responder ao seu pedido, de acordo com a <a href="/privacidade">Política de Privacidade</a>.</p>
        <div class="contact-form__footer">
          <button type="submit" class="contact-form__submit">Enviar pedido</button>
          <p id="form-status" class="contact-form__status" role="status" aria-live="polite" aria-atomic="true"></p>
        </div>
        <p class="contact-form__fallback">Se tiver algum problema com o formulário, pode contactar-me por <a href="mailto:info@brunofaustino.pt">email</a>{whatsappUrl && <> ou por <a href={whatsappUrl}>WhatsApp Business</a></>}.</p>
      </form>

      <div class="contact-main__info">
        <div class="contact-info">
          <h2>Email</h2>
          <p>Para apresentar o seu projeto ou esclarecer uma questão.</p>
          <a href="mailto:info@brunofaustino.pt">info@brunofaustino.pt</a>
        </div>
        <div class="contact-info">
          <h2>WhatsApp Business</h2>
          <p>Para uma mensagem rápida ou primeiro contacto.</p>
          {whatsappUrl && <a href={whatsappUrl}>Enviar mensagem no WhatsApp <span aria-hidden="true">↗</span></a>}
        </div>
        <div class="contact-info contact-info--location">
          <h2>Localização</h2>
          <p>Portugal</p>
        </div>
        <p class="contact-expectation">Normalmente respondo por email até 2 dias úteis.</p>
      </div>
    </div>
  </section>

  <section class="contact-process" aria-labelledby="process-title">
    <div class="container">
      <h2 id="process-title">O que acontece depois</h2>
      <div class="contact-process__grid">
        {steps.map(([title, description], index) => (
          <article>
            <span class="contact-process__number">0{index + 1}</span>
            <h3>{title}</h3>
            <p>{description}</p>
          </article>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  const form = document.querySelector<HTMLFormElement>("#formulario");
  const button = form?.querySelector<HTMLButtonElement>('button[type="submit"]');
  const status = document.querySelector<HTMLElement>("#form-status");

  if (form && button && status) {
    let submitting = false;
    let recoveryTimer: ReturnType<typeof setTimeout> | undefined;
    const restore = (message = "") => {
      clearTimeout(recoveryTimer);
      submitting = false;
      button.disabled = false;
      button.removeAttribute("aria-busy");
      button.textContent = "Enviar pedido";
      status.textContent = message;
    };

    form.addEventListener("submit", (event) => {
      if (submitting) {
        event.preventDefault();
        return;
      }
      if (event.defaultPrevented) return;
      try {
        submitting = true;
        button.disabled = true;
        button.setAttribute("aria-busy", "true");
        button.textContent = "A enviar…";
        status.textContent = "A enviar o seu pedido…";
        // A submissão continua a ser um POST nativo do navegador.
        // Se outro handler a cancelar, a interface volta ao estado inicial.
        queueMicrotask(() => {
          if (event.defaultPrevented) restore();
        });
        // O POST nativo não expõe erros de rede a esta página. Recuperar
        // os controlos caso o documento permaneça aberto sem navegar.
        recoveryTimer = setTimeout(() => {
          restore("O envio ainda não foi confirmado. Se continuar nesta página, pode tentar novamente.");
        }, 30000);
      } catch {
        restore();
      }
    });
    window.addEventListener("pageshow", () => restore());
    window.addEventListener("offline", () => {
      if (submitting) restore("Sem ligação à Internet. Verifique a ligação antes de tentar novamente.");
    });
  }
</script>

<style>
  .contact-main { background: var(--color-bg-primary); padding-block: var(--space-9); }
  .contact-main__grid {
    display: grid;
    grid-template-columns: minmax(0, 0.85fr) minmax(0, 1.15fr);
    grid-template-areas: "opening form" "info form";
    gap: var(--space-7) clamp(48px, 6vw, 88px);
    align-items: start;
  }
  .contact-opening { grid-area: opening; }
  .contact-eyebrow {
    margin-bottom: var(--space-5); color: var(--color-primary-hover);
    font-size: 0.75rem; font-weight: 600; letter-spacing: 0.14em; text-transform: uppercase;
  }
  .contact-opening h1 { font-size: clamp(2.75rem, 4.8vw, 4.8rem); line-height: 1.04; letter-spacing: -0.055em; margin-bottom: var(--space-6); }
  .contact-opening__lead { font-size: 1.08rem; line-height: 1.65; margin: 0; }
  .contact-main__info { grid-area: info; }
  .contact-info { padding-block: var(--space-5); border-top: 1px solid var(--color-border); }
  .contact-info h2 { margin-bottom: var(--space-3); color: var(--color-text-secondary); font-size: 0.75rem; font-weight: 600; letter-spacing: 0.1em; text-transform: uppercase; }
  .contact-info p { margin-bottom: var(--space-3); font-size: 0.95rem; }
  .contact-info--location p { margin: 0; }
  .contact-info a { color: var(--color-text-primary); font-size: 0.95rem; overflow-wrap: anywhere; }
  .contact-info a, .contact-form a { text-decoration: underline; text-underline-offset: 4px; }
  .contact-info a:hover, .contact-form a:hover { color: var(--color-primary-hover); }
  .contact-expectation { margin: var(--space-4) 0 0; font-size: 0.9rem; color: var(--color-text-secondary); }
  .contact-form { grid-area: form; position: relative; display: grid; gap: var(--space-5); min-width: 0; scroll-margin-top: 112px; padding: var(--space-6); background: var(--color-bg-secondary); border: 1px solid var(--color-border); border-radius: var(--radius-lg); }
  .contact-form__honeypot { position: absolute; width: 1px; height: 1px; margin: -1px; padding: 0; overflow: hidden; clip: rect(0 0 0 0); clip-path: inset(50%); white-space: nowrap; border: 0; }
  .contact-form__row { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: var(--space-5); }
  .contact-form__field { display: grid; gap: var(--space-3); min-width: 0; }
  .contact-form label { color: var(--color-text-primary); font-size: 0.9rem; font-weight: 500; }
  .contact-form label span { color: var(--color-text-secondary); font-size: 0.75rem; font-weight: 400; }
  .contact-form input, .contact-form select, .contact-form textarea { width: 100%; min-width: 0; border: 1px solid #777b83; border-radius: var(--radius-md); background: var(--color-bg-primary); color: var(--color-text-primary); }
  .contact-form input, .contact-form select { min-height: 52px; padding-inline: var(--space-3); }
  .contact-form select { font-size: 0.9rem; }
  .contact-form textarea { min-height: 160px; padding: var(--space-4); resize: vertical; }
  .contact-form textarea::placeholder { color: var(--color-text-secondary); opacity: 1; }
  .contact-form input:focus-visible, .contact-form select:focus-visible, .contact-form textarea:focus-visible { outline: 2px solid var(--color-primary-hover); outline-offset: 3px; border-color: var(--color-primary-hover); }
  .contact-form__hint, .contact-form__privacy, .contact-form__fallback, .contact-form__status { margin: 0; color: var(--color-text-secondary); font-size: 0.82rem; line-height: 1.6; }
  .contact-form a { color: var(--color-text-primary); }
  .contact-form__footer { display: grid; justify-items: start; gap: var(--space-3); }
  .contact-form__status:empty { display: none; }
  .contact-form__submit { min-height: 52px; padding: 14px 24px; border: 1px solid var(--color-text-primary); border-radius: var(--radius-md); background: var(--color-text-primary); color: var(--color-bg-primary); font-size: 0.95rem; font-weight: 500; cursor: pointer; }
  .contact-form__submit:hover:not(:disabled) { background: transparent; color: var(--color-text-primary); }
  .contact-form__submit:disabled { cursor: wait; }
  .contact-process { background: var(--color-bg-secondary); padding-block: var(--space-8); }
  .contact-process h2 { margin-bottom: var(--space-7); font-size: clamp(1.75rem, 3vw, 2.6rem); }
  .contact-process__grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: var(--space-7); }
  .contact-process__grid article { padding-top: var(--space-5); border-top: 1px solid var(--color-border); }
  .contact-process__number { display: block; margin-bottom: var(--space-5); color: var(--color-primary-hover); font-size: 0.8rem; font-weight: 600; }
  .contact-process h3 { font-size: 1.4rem; margin-bottom: var(--space-3); }
  .contact-process__grid p { margin: 0; }
  @media (max-width: 900px) {
    .contact-main__grid { grid-template-columns: minmax(0, 1fr); grid-template-areas: "opening" "form" "info"; }
    .contact-main { padding-block: var(--space-8); }
    .contact-opening { max-width: 680px; }
    .contact-process__grid { grid-template-columns: 1fr; gap: var(--space-6); }
  }
  @media (max-width: 640px) {
    .contact-form { padding: var(--space-5) var(--space-4); }
    .contact-form__row { grid-template-columns: 1fr; }
    .contact-form__footer { justify-items: stretch; }
  }
</style>
