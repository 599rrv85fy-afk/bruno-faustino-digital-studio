---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  title="Contactos — Bruno Faustino Digital Studio"
  description="Fale sobre o seu projeto, desafio ou objetivo digital com a Bruno Faustino Digital Studio."
>
  <section class="contact-hero">
    <div class="container contact-hero__grid">

      <div class="contact-hero__content">
        <p class="contact-hero__eyebrow">
          Contactos
        </p>

        <h1 class="contact-hero__title">
          Vamos falar sobre o seu projeto.
        </h1>
      </div>

      <div class="contact-hero__intro">
        <p class="contact-hero__lead">
          Se pretende criar, melhorar ou repensar alguma parte da sua
          presença digital, este é o ponto de partida.
        </p>

        <p>
          Uma breve descrição do contexto, do objetivo ou do problema atual
          é suficiente para iniciar a conversa.
        </p>
      </div>

    </div>
  </section>

  <section class="contact-main">
    <div class="container contact-main__grid">

      <div class="contact-main__info">

        <div class="contact-info">
          <p class="contact-info__label">
            Email
          </p>

          <a href="mailto:hello@brunofaustino.pt">
            hello@brunofaustino.pt
          </a>
        </div>

        <div class="contact-info">
          <p class="contact-info__label">
            Localização
          </p>

          <p>
            Portugal
          </p>
        </div>

        <div class="contact-info">
          <p class="contact-info__label">
            Áreas
          </p>

          <p>
            Websites, estratégia digital, SEO, automação e tecnologia.
          </p>
        </div>

        <div class="contact-main__note">
          <p>
            Não é necessário preparar um briefing completo antes do primeiro
            contacto.
          </p>
        </div>

      </div>

      <div class="contact-main__form-wrapper">

        <form
          class="contact-form"
          name="contacto"
          method="POST"
          action="/obrigado"
          data-netlify="true"
          netlify-honeypot="website"
        >
          <input
            type="hidden"
            name="form-name"
            value="contacto"
          />

          <div
            class="contact-form__honeypot"
            aria-hidden="true"
          >
            <label for="website">
              Não preencher este campo
            </label>

            <input
              type="text"
              id="website"
              name="website"
              tabindex="-1"
              autocomplete="off"
            />
          </div>

          <div class="contact-form__row">

            <div class="contact-form__field">
              <label for="nome">
                Nome
              </label>

              <input
                type="text"
                id="nome"
                name="nome"
                autocomplete="name"
                required
              />
            </div>

            <div class="contact-form__field">
              <label for="empresa">
                Empresa
                <span>Opcional</span>
              </label>

              <input
                type="text"
                id="empresa"
                name="empresa"
                autocomplete="organization"
              />
            </div>

          </div>

          <div class="contact-form__row">

            <div class="contact-form__field">
              <label for="email">
                Email
              </label>

              <input
                type="email"
                id="email"
                name="email"
                autocomplete="email"
                required
              />
            </div>

            <div class="contact-form__field">
              <label for="telefone">
                Telefone
                <span>Opcional</span>
              </label>

              <input
                type="tel"
                id="telefone"
                name="telefone"
                autocomplete="tel"
              />
            </div>

          </div>

          <div class="contact-form__field">
            <label for="tipo-projeto">
              Em que posso ajudar?
            </label>

            <select
              id="tipo-projeto"
              name="tipo-projeto"
              required
            >
              <option value="" selected disabled>
                Selecione uma opção
              </option>

              <option value="Website">
                Website
              </option>

              <option value="Estratégia Digital">
                Estratégia Digital
              </option>

              <option value="SEO & Visibilidade">
                SEO &amp; Visibilidade
              </option>

              <option value="Automação & Tecnologia">
                Automação &amp; Tecnologia
              </option>

              <option value="Outro">
                Outro
              </option>
            </select>
          </div>

          <div class="contact-form__field">
            <label for="mensagem">
              Fale-me sobre o projeto
            </label>

            <textarea
              id="mensagem"
              name="mensagem"
              rows="7"
              placeholder="Contexto, objetivo, problema atual ou aquilo que pretende melhorar."
              required
            ></textarea>
          </div>

          <div class="contact-form__privacy">
            <p>
              Ao enviar este formulário, os dados fornecidos serão utilizados
              para responder ao seu pedido, nos termos da
              <a href="/privacidade">
                Política de Privacidade
              </a>.
            </p>
          </div>

          <div class="contact-form__footer">

            <button
              type="submit"
              class="contact-form__submit"
            >
              Enviar pedido
            </button>

            <p>
              Resposta normalmente dentro de 1–2 dias úteis.
            </p>

          </div>

        </form>

      </div>

    </div>
  </section>

  <section class="contact-process">
    <div class="container">

      <div class="contact-process__header">
        <p class="contact-process__eyebrow">
          Depois do contacto
        </p>

        <h2>
          Um processo simples para perceber se faz sentido avançar.
        </h2>
      </div>

      <div class="contact-process__grid">

        <article>
          <span>01</span>

          <h3>
            Análise
          </h3>

          <p>
            Analiso o contexto, o objetivo e a informação enviada.
          </p>
        </article>

        <article>
          <span>02</span>

          <h3>
            Conversa
          </h3>

          <p>
            Se houver enquadramento, esclarecemos necessidades,
            prioridades e expectativas.
          </p>
        </article>

        <article>
          <span>03</span>

          <h3>
            Proposta
          </h3>

          <p>
            Quando aplicável, é apresentada uma proposta com âmbito,
            prazos, entregáveis e investimento.
          </p>
        </article>

      </div>

    </div>
  </section>
</BaseLayout>

<style>
  .contact-hero {
    background: var(--color-bg-primary);
  }

  .contact-hero__grid {
    display: grid;
    grid-template-columns:
      minmax(0, 1.2fr)
      minmax(320px, 0.8fr);

    align-items: end;

    gap: clamp(64px, 10vw, 140px);
  }

  .contact-hero__eyebrow,
  .contact-process__eyebrow {
    margin-bottom: var(--space-6);

    color: var(--color-primary);

    font-size: 0.75rem;
    font-weight: 600;

    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .contact-hero__title {
    max-width: 1050px;

    margin-bottom: 0;

    font-size: clamp(3.5rem, 6.5vw, 7rem);
    line-height: 0.96;

    letter-spacing: -0.055em;
  }

  .contact-hero__intro {
    max-width: 600px;
  }

  .contact-hero__lead {
    color: var(--color-text-primary);

    font-size: clamp(1.25rem, 2vw, 1.6rem);
    line-height: 1.5;
  }

  .contact-main {
    background: var(--color-bg-secondary);
  }

  .contact-main__grid {
    display: grid;
    grid-template-columns:
      minmax(260px, 0.65fr)
      minmax(0, 1.35fr);

    gap: clamp(64px, 10vw, 140px);

    align-items: start;
  }

  .contact-main__info {
    position: sticky;
    top: 140px;
  }

  .contact-info {
    padding-block: var(--space-5);

    border-top: 1px solid var(--color-border);
  }

  .contact-info:last-of-type {
    border-bottom: 1px solid var(--color-border);
  }

  .contact-info__label {
    margin-bottom: var(--space-3);

    color: var(--color-text-muted);

    font-size: 0.72rem;
    font-weight: 600;

    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .contact-info a,
  .contact-info p:last-child {
    margin: 0;

    color: var(--color-text-primary);

    font-size: 1rem;
  }

  .contact-info a:hover {
    color: var(--color-primary-hover);
  }

  .contact-main__note {
    margin-top: var(--space-7);
  }

  .contact-main__note p {
    max-width: 360px;

    margin-bottom: 0;
  }

  .contact-form {
    position: relative;

    display: grid;

    gap: var(--space-6);
  }

  .contact-form__honeypot {
    position: absolute;

    width: 1px;
    height: 1px;

    margin: -1px;
    padding: 0;

    overflow: hidden;

    clip: rect(0 0 0 0);
    clip-path: inset(50%);

    white-space: nowrap;

    border: 0;
  }

  .contact-form__row {
    display: grid;
    grid-template-columns:
      repeat(2, minmax(0, 1fr));

    gap: var(--space-5);
  }

  .contact-form__field {
    display: grid;

    gap: var(--space-3);
  }

  .contact-form label {
    color: var(--color-text-primary);

    font-size: 0.9rem;
    font-weight: 500;
  }

  .contact-form label span {
    margin-left: var(--space-2);

    color: var(--color-text-muted);

    font-size: 0.75rem;
    font-weight: 400;
  }

  .contact-form input,
  .contact-form select,
  .contact-form textarea {
    width: 100%;

    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);

    background: var(--color-bg-primary);
    color: var(--color-text-primary);

    transition:
      border-color var(--transition-fast),
      background-color var(--transition-fast);
  }

  .contact-form input,
  .contact-form select {
    min-height: 52px;

    padding-inline: var(--space-4);
  }

  .contact-form textarea {
    min-height: 180px;

    padding: var(--space-4);

    resize: vertical;
  }

  .contact-form input::placeholder,
  .contact-form textarea::placeholder {
    color: var(--color-text-muted);
  }

  .contact-form input:focus,
  .contact-form select:focus,
  .contact-form textarea:focus {
    outline: none;

    border-color: var(--color-primary);
  }

  .contact-form__privacy {
    padding-top: var(--space-2);
  }

  .contact-form__privacy p {
    max-width: 700px;

    margin: 0;

    color: var(--color-text-muted);

    font-size: 0.82rem;
    line-height: 1.6;
  }

  .contact-form__privacy a {
    color: var(--color-text-primary);

    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .contact-form__footer {
    display: flex;
    align-items: center;

    gap: var(--space-5);

    margin-top: var(--space-2);
  }

  .contact-form__submit {
    min-height: 52px;

    padding: 14px 24px;

    border: 1px solid var(--color-text-primary);
    border-radius: var(--radius-md);

    background: var(--color-text-primary);
    color: var(--color-bg-primary);

    font-size: 0.95rem;
    font-weight: 500;

    cursor: pointer;

    transition:
      background-color var(--transition-fast),
      color var(--transition-fast),
      transform var(--transition-fast);
  }

  .contact-form__submit:hover {
    background: transparent;
    color: var(--color-text-primary);
  }

  .contact-form__submit:active {
    transform: translateY(1px);
  }

  .contact-form__submit:focus-visible {
    outline: 2px solid var(--color-primary-hover);
    outline-offset: 4px;
  }

  .contact-form__footer p {
    margin: 0;

    color: var(--color-text-muted);

    font-size: 0.8rem;
  }

  .contact-process {
    background: var(--color-bg-primary);
  }

  .contact-process__header {
    display: grid;
    grid-template-columns:
      minmax(180px, 0.35fr)
      minmax(0, 1.65fr);

    gap: var(--space-8);

    margin-bottom: var(--space-9);
  }

  .contact-process__header h2 {
    max-width: 900px;

    margin-bottom: 0;
  }

  .contact-process__grid {
    display: grid;
    grid-template-columns:
      repeat(3, minmax(0, 1fr));

    border-top: 1px solid var(--color-border);
  }

  .contact-process__grid article {
    padding: var(--space-7);

    border-right: 1px solid var(--color-border);
    border-bottom: 1px solid var(--color-border);
  }

  .contact-process__grid article:first-child {
    padding-left: 0;
  }

  .contact-process__grid article:last-child {
    padding-right: 0;
    border-right: 0;
  }

  .contact-process__grid span {
    display: block;

    margin-bottom: var(--space-6);

    color: var(--color-text-muted);

    font-size: 0.75rem;
    font-weight: 600;

    letter-spacing: 0.12em;
  }

  .contact-process__grid h3 {
    margin-bottom: var(--space-3);

    font-size: clamp(1.4rem, 2vw, 1.9rem);
    font-weight: 500;
  }

  .contact-process__grid p {
    margin-bottom: 0;
  }

  @media (max-width: 900px) {
    .contact-hero__grid,
    .contact-main__grid,
    .contact-process__header {
      grid-template-columns: 1fr;
    }

    .contact-hero__grid,
    .contact-main__grid {
      gap: var(--space-8);
    }

    .contact-main__info {
      position: static;
    }

    .contact-process__grid {
      grid-template-columns: 1fr;
    }

    .contact-process__grid article {
      padding: var(--space-7) 0;

      border-right: 0;
    }
  }

  @media (max-width: 640px) {
    .contact-hero__title {
      font-size: clamp(3rem, 14vw, 4.6rem);
    }

    .contact-form__row {
      grid-template-columns: 1fr;
    }

    .contact-form__footer {
      flex-direction: column;
      align-items: stretch;
    }
  }
</style>