---
import BaseLayout from "../layouts/BaseLayout.astro";
import Button from "../components/ui/Button.astro";
---

<BaseLayout
  title="Pedido enviado — Bruno Faustino Digital Studio"
  description="Obrigado pelo contacto. A sua mensagem foi enviada com sucesso."
  noindex={true}
>
  <section class="thank-you">
    <div class="container thank-you__grid">
      <div class="thank-you__content">
        <p class="thank-you__eyebrow">
          Pedido enviado
        </p>

        <h1>
          Obrigado pelo contacto.
        </h1>

        <p class="thank-you__text">
          Recebi a sua mensagem e normalmente respondo por email até 2 dias úteis.
        </p>

        <p class="thank-you__secondary">Entretanto, pode continuar a conhecer os serviços e projetos da Bruno Faustino Digital Studio.</p>

        <div class="thank-you__actions">
          <Button href="/servicos">
            Ver serviços
          </Button>

          <Button
            href="/projetos"
            variant="secondary"
          >
            Ver projetos
          </Button>
        </div>
      </div>

      <div
        class="thank-you__visual"
        aria-hidden="true"
      >
        <div class="thank-you__mark">
          <img src="/images/brand/bf-branco.svg" alt="" width="145" height="103" />
        </div>

        <span>
          Mensagem recebida
        </span>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .thank-you {
    display: flex;
    align-items: center;

    padding-block: var(--space-8);

    background: var(--color-bg-primary);
  }

  .thank-you__grid {
    display: grid;
    grid-template-columns:
      minmax(0, 1.15fr)
      minmax(220px, 0.65fr);

    align-items: center;

    gap: var(--space-8);
  }

  .thank-you__content {
    max-width: 760px;
  }

  .thank-you__eyebrow {
    margin-bottom: var(--space-5);

    color: var(--color-primary-hover);

    font-size: 0.75rem;
    font-weight: 600;

    letter-spacing: 0.16em;
    text-transform: uppercase;
  }

  .thank-you h1 {
    max-width: 700px;

    margin-bottom: var(--space-6);
  }

  .thank-you__text {
    max-width: 620px;

    margin-bottom: var(--space-7);

    font-size: 1.08rem;
  }

  .thank-you__secondary {
    max-width: 620px;
    margin-bottom: var(--space-6);
  }

  .thank-you__mark img { width: 116px; height: auto; }

  .thank-you__actions {
    display: flex;
    flex-wrap: wrap;

    gap: var(--space-3);
  }

  .thank-you__visual {
    position: relative;

    display: flex;
    flex-direction: column;
    justify-content: space-between;

    min-height: 260px;

    padding: var(--space-7);

    border:
      1px solid
      rgba(255, 255, 255, 0.08);

    border-radius: var(--radius-lg);

    background:
      linear-gradient(
        145deg,
        var(--color-bg-elevated),
        var(--color-bg-secondary)
      );
  }

  .thank-you__mark {
    color: var(--color-text-primary);

    font-size: clamp(3rem, 6vw, 5rem);
    font-weight: 700;

    letter-spacing: -0.05em;
  }

  .thank-you__visual span {
    padding-top: var(--space-5);

    border-top:
      1px solid
      rgba(255, 255, 255, 0.08);

    color: var(--color-text-secondary);

    font-size: 0.75rem;
    font-weight: 600;

    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  @media (max-width: 900px) {
    .thank-you__grid {
      grid-template-columns: 1fr;
    }

    .thank-you__visual {
      min-height: 180px;
    }
  }

  @media (max-width: 640px) {
    .thank-you {
      min-height: auto;
    }

    .thank-you__actions {
      flex-direction: column;
    }

    .thank-you__visual {
      min-height: 160px;

      padding: var(--space-6);
    }
  }
</style>