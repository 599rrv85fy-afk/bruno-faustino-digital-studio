---
import "../styles/global.css";

import Header from "../components/global/Header.astro";
import Footer from "../components/global/Footer.astro";
import SEO from "../components/global/SEO.astro";

const {
  title = "Bruno Faustino Digital Studio",
  description = "Estratégia, tecnologia e soluções digitais para negócios mais fortes.",
  canonical,
  image,
  type = "website",
  noindex = false,
} = Astro.props;
---

<!doctype html>

<html lang="pt-PT">
  <head>
    <meta charset="UTF-8" />

    <meta
      name="viewport"
      content="width=device-width, initial-scale=1"
    />

    <SEO
      title={title}
      description={description}
      canonical={canonical}
      image={image}
      type={type}
      noindex={noindex}
    />

    <link
      rel="icon"
      type="image/svg+xml"
      href="/favicon.svg"
    />

    <slot name="head" />
  </head>

  <body>
    <a
      href="#conteudo-principal"
      class="skip-link"
    >
      Saltar para o conteúdo
    </a>

    <Header />

    <main
      id="conteudo-principal"
      tabindex="-1"
    >
      <slot />
    </main>

    <Footer />
  </body>
</html>