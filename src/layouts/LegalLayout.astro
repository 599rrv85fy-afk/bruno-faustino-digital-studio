---
import BaseLayout from "./BaseLayout.astro";

const {
  title,
  description,
  eyebrow,
  heading,
  updated = "11 de setembro de 2026",
} = Astro.props;
---

<BaseLayout
  title={`${title} — Bruno Faustino Digital Studio`}
  description={description}
>
  <section class="legal-hero">
    <div class="container">
      <p class="legal-hero__eyebrow">
        {eyebrow}
      </p>

      <h1 class="legal-hero__title">
        {heading}
      </h1>

      <p class="legal-hero__updated">
        Última atualização: {updated}
      </p>
    </div>
  </section>

  <section class="legal-content">
    <div class="container legal-content__grid">

      <aside class="legal-content__aside">
        <p>
          Informação legal
        </p>

        <span>
          Bruno Faustino Digital Studio
        </span>
      </aside>

      <article class="legal-content__body">
        <slot />
      </article>

    </div>
  </section>
</BaseLayout>

<style>
  .legal-hero {
    background: var(--color-bg-primary);
  }

  .legal-hero__eyebrow {
    margin-bottom: var(--space-6);

    color: var(--color-primary);

    font-size: 0.75rem;
    font-weight: 600;

    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .legal-hero__title {
    max-width: 1000px;

    margin-bottom: var(--space-6);

    font-size: clamp(3.5rem, 6.5vw, 6.5rem);
    line-height: 0.96;

    letter-spacing: -0.055em;
  }

  .legal-hero__updated {
    margin-bottom: 0;

    color: var(--color-text-muted);

    font-size: 0.85rem;
  }

  .legal-content {
    background: var(--color-bg-secondary);
  }

  .legal-content__grid {
    display: grid;
    grid-template-columns:
      minmax(180px, 0.35fr)
      minmax(0, 1.65fr);

    gap: clamp(64px, 10vw, 140px);

    align-items: start;
  }

  .legal-content__aside {
    position: sticky;
    top: 140px;
  }

  .legal-content__aside p {
    margin-bottom: var(--space-3);

    color: var(--color-primary);

    font-size: 0.72rem;
    font-weight: 600;

    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .legal-content__aside span {
    color: var(--color-text-secondary);

    font-size: 0.9rem;
  }

  .legal-content__body {
    max-width: 860px;
  }

  .legal-content__body :global(section) {
    padding: 0;
  }

  .legal-content__body :global(section + section) {
    margin-top: var(--space-9);
  }

  .legal-content__body :global(h2) {
    margin-bottom: var(--space-5);

    font-size: clamp(1.8rem, 3vw, 2.8rem);
    font-weight: 500;
  }

  .legal-content__body :global(h3) {
    margin-top: var(--space-6);
    margin-bottom: var(--space-3);

    font-size: 1.2rem;
    font-weight: 500;
  }

  .legal-content__body :global(p),
  .legal-content__body :global(li) {
    color: var(--color-text-secondary);
  }

  .legal-content__body :global(ul) {
    padding-left: 1.25rem;
  }

  .legal-content__body :global(li + li) {
    margin-top: var(--space-2);
  }

  .legal-content__body :global(a) {
    color: var(--color-text-primary);

    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .legal-content__body :global(strong) {
    color: var(--color-text-primary);
    font-weight: 500;
  }

  .legal-placeholder {
    padding: var(--space-5);

    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);

    background: var(--color-bg-primary);

    color: var(--color-text-secondary);
  }

  @media (max-width: 900px) {
    .legal-content__grid {
      grid-template-columns: 1fr;

      gap: var(--space-8);
    }

    .legal-content__aside {
      position: static;
    }
  }

  @media (max-width: 640px) {
    .legal-hero__title {
      font-size: clamp(3rem, 14vw, 4.5rem);
    }
  }
</style>