---
import BaseLayout from "./BaseLayout.astro";
import Button from "../components/ui/Button.astro";
const { project } = Astro.props;
const gallery = (project.gallery ?? []).filter((item) => item.image && item.alt);
const sections = (project.sections ?? []).filter((section) => section.title && (section.type === "gallery" ? gallery.length : section.paragraphs?.length));
---
<BaseLayout title={`${project.title} — ${project.nature} — Bruno Faustino Digital Studio`} description={project.seoDescription ?? project.excerpt} image={project.coverImage} imageWidth={project.coverWidth} imageHeight={project.coverHeight} imageType={project.coverType} imageAlt={project.coverAlt}>
  <section class:list={["case-hero", {"case-hero--brief":project.detailVariant === "brief"}]}>
    <div class="container">
      <a class="case-back" href="/projetos">← Voltar a Projetos</a>
      <div class="case-hero__grid">
        <div>
          <p class="case-eyebrow">{project.detailVariant === "brief" ? "Contexto do projeto" : project.nature}</p>
          <h1>{project.title}</h1>
          <p class="case-intro">{project.introduction ?? project.excerpt}</p>
          {project.notice && <p class="case-notice">{project.notice}</p>}
        </div>
        <dl class="case-meta">
          <div><dt>Natureza</dt><dd>{project.nature}</dd></div>
          <div><dt>Setor</dt><dd>{project.sector}</dd></div>
          <div><dt>Estado</dt><dd>{project.status}</dd></div>
          {project.year && <div><dt>Ano</dt><dd>{project.year}</dd></div>}
        </dl>
      </div>
    </div>
  </section>
  {sections.map((section) => <section class:list={["case-section", {"case-section--gallery": section.type === "gallery"}]} aria-labelledby={section.id}>
    <div class="container case-section__grid">
      <h2 id={section.id}>{section.title}</h2>
      {section.type === "gallery" ? <div class="case-gallery">
        {gallery.map((item) => <figure class:list={["case-gallery__item", {"case-gallery__item--mobile": item.layout === "mobile"}]}>
          <a href={item.image} aria-label={`Abrir imagem: ${item.label}`}><img src={item.image} alt={item.alt} width={item.width} height={item.height} loading="lazy" decoding="async" /></a>
          {item.label && <figcaption>{item.label}</figcaption>}
        </figure>)}
      </div> : <div class="case-copy">{section.paragraphs.map((paragraph) => <p>{paragraph}</p>)}</div>}
    </div>
  </section>)}
  <section class="case-cta">
    <div class="container case-cta__inner">
      <a class="case-back" href="/projetos">← Voltar a Projetos</a>
      <Button href="/contactos">Falar sobre um projeto</Button>
    </div>
  </section>
</BaseLayout>
<style>
  .case-back { display: inline-block; color: var(--color-text-secondary); margin-bottom: var(--space-8); }
  a:focus-visible { outline: 2px solid var(--color-primary-hover); outline-offset: 6px; border-radius: 4px; }
  .case-hero__grid { display: grid; grid-template-columns: minmax(0, 1.5fr) minmax(0, 0.8fr); gap: clamp(2rem, 6vw, 6rem); align-items: start; }
  .case-eyebrow { color: var(--color-primary); font-size: 0.8rem; text-transform: uppercase; letter-spacing: 0.1em; }
  h1 { font-size: clamp(2.8rem, 6vw, 6rem); line-height: 1.04; letter-spacing: -0.05em; overflow-wrap: anywhere; }
  .case-hero--brief h1 { font-size: clamp(2.5rem, 4.8vw, 4.8rem); }
  .case-intro { font-size: clamp(1.15rem, 1.8vw, 1.45rem); max-width: 48rem; }
  .case-notice { padding: 1rem 1.25rem; border-left: 2px solid var(--color-primary); background: var(--color-bg-secondary); color: var(--color-text-primary); }
  .case-meta { margin: 0; display: grid; gap: 1.25rem; border-top: 1px solid var(--color-border); padding-top: 1.5rem; }
  .case-meta div { display: grid; gap: 0.35rem; }
  .case-meta dt { font-size: 0.8rem; color: var(--color-text-secondary); }
  .case-meta dd { margin: 0; color: var(--color-text-primary); }
  .case-section { padding-block: clamp(2.5rem, 5vw, 5rem); border-top: 1px solid var(--color-border); }
  .case-section__grid { display: grid; grid-template-columns: minmax(0, 0.7fr) minmax(0, 1.3fr); gap: clamp(2rem, 5vw, 5rem); }
  .case-section h2 { font-size: clamp(1.7rem, 3vw, 2.8rem); line-height: 1.15; }
  .case-copy { max-width: 48rem; }
  .case-copy p:last-child { margin-bottom: 0; }
  .case-section--gallery { background: var(--color-bg-secondary); }
  .case-section--gallery .case-section__grid { grid-template-columns: minmax(0, 1fr); gap: 1.5rem; }
  .case-gallery { display: grid; grid-template-columns: minmax(0, 1fr); gap: 3rem; }
  .case-gallery__item { margin: 0; min-width: 0; }
  .case-gallery__item a { display: block; }
  .case-gallery img { display: block; width: 100%; height: auto; border: 1px solid var(--color-border); border-radius: var(--radius-lg); }
  .case-gallery__item--mobile { max-width: 24rem; justify-self: center; }
  figcaption { margin-top: 1rem; color: var(--color-text-secondary); font-size: 0.95rem; }
  .case-cta { border-top: 1px solid var(--color-border); }
  .case-cta__inner { display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 2rem; }
  .case-cta .case-back { margin: 0; }
  @media (max-width: 900px) { .case-hero__grid, .case-section__grid { grid-template-columns: minmax(0, 1fr); } }
</style>
