---
import BaseLayout from "./BaseLayout.astro";
import Button from "../components/ui/Button.astro";

const { project } = Astro.props;

const hasCover = Boolean(project.coverImage);
const coverFit = project.coverFit ?? "cover";
const coverAspectRatio = project.coverAspectRatio ?? "4 / 5";

const [coverWidth, coverHeight] = coverAspectRatio
  .split("/")
  .map(Number);

const isLandscapeCover = coverWidth > coverHeight;
---

<BaseLayout
  title={`${project.title} — Bruno Faustino Digital Studio`}
  description={project.excerpt}
>
  <section class="case-study-hero">
    <div class="container case-study-hero__grid">
      <div class="case-study-hero__content">
        <p class="case-study-hero__eyebrow">
          Case Study
        </p>

        <h1 class="case-study-hero__title">
          {project.title}
        </h1>

        <p class="case-study-hero__excerpt">
          {project.excerpt}
        </p>
      </div>

      <div class="case-study-hero__meta">
        <div>
          <span>Setor</span>
          <strong>{project.category}</strong>
        </div>

        <div>
          <span>Ano</span>
          <strong>{project.year}</strong>
        </div>

        <div>
          <span>Estado</span>
          <strong>{project.status}</strong>
        </div>
      </div>
    </div>
  </section>

  <section class="case-study-visual">
    <div class="container">
      <div
        class:list={[
          "case-study-visual__frame",
          `case-study-visual__frame--${project.theme}`,
        ]}
      >
        {
          hasCover ? (
            <div
              class:list={[
                "case-study-visual__editorial",
                {
                  "case-study-visual__editorial--landscape": isLandscapeCover,
                },
              ]}
            >
              <div
                class:list={[
                  "case-study-visual__media",
                  {
                    "case-study-visual__media--landscape": isLandscapeCover,
                  },
                ]}
                style={{ aspectRatio: coverAspectRatio }}
              >
                <img
                  src={project.coverImage}
                  alt={
                    project.coverAlt ??
                    `Imagem principal do projeto ${project.title}`
                  }
                  class="case-study-visual__image"
                  style={{ objectFit: coverFit }}
                  loading="eager"
                  decoding="async"
                />
              </div>

              <div class="case-study-visual__content">
                <p class="case-study-visual__eyebrow">
                  Projeto
                </p>

                <h2 class="case-study-visual__title">
                  {project.title}
                </h2>

                <p class="case-study-visual__category">
                  {project.category}
                </p>

                <p class="case-study-visual__statement">
                  Presença digital pensada para reforçar autoridade,
                  confiança e proximidade.
                </p>

                <div class="case-study-visual__status">
                  <span>
                    {project.status}
                  </span>

                  <span aria-hidden="true">
                    ·
                  </span>

                  <span>
                    {project.year}
                  </span>
                </div>
              </div>
            </div>
          ) : (
            <div class="case-study-visual__placeholder">
              <span>
                {project.title}
              </span>
            </div>
          )
        }
      </div>
    </div>
  </section>

  <section class="case-study-overview">
    <div class="container case-study-overview__grid">
      <div class="case-study-overview__label">
        <p>
          Visão geral
        </p>
      </div>

      <div class="case-study-overview__content">
        <h2>
          {project.challenge.title}
        </h2>

        <p class="case-study-overview__lead">
          {project.challenge.text}
        </p>
      </div>
    </div>
  </section>

  <section class="case-study-details">
    <div class="container">
      <article class="case-study-detail">
        <span class="case-study-detail__number">
          01
        </span>

        <div class="case-study-detail__content">
          <p class="case-study-detail__eyebrow">
            Desafio
          </p>

          <h2>
            {project.challenge.title}
          </h2>

          <p>
            {project.challenge.text}
          </p>
        </div>
      </article>

      <article class="case-study-detail">
        <span class="case-study-detail__number">
          02
        </span>

        <div class="case-study-detail__content">
          <p class="case-study-detail__eyebrow">
            Estratégia
          </p>

          <h2>
            {project.strategy.title}
          </h2>

          <p>
            {project.strategy.text}
          </p>
        </div>
      </article>

      <article class="case-study-detail">
        <span class="case-study-detail__number">
          03
        </span>

        <div class="case-study-detail__content">
          <p class="case-study-detail__eyebrow">
            Solução
          </p>

          <h2>
            {project.solution.title}
          </h2>

          <p>
            {project.solution.text}
          </p>
        </div>
      </article>

      <article class="case-study-detail">
        <span class="case-study-detail__number">
          04
        </span>

        <div class="case-study-detail__content">
          <p class="case-study-detail__eyebrow">
            Resultados
          </p>

          <h2>
            {project.results.title}
          </h2>

          <p>
            {project.results.text}
          </p>
        </div>
      </article>
    </div>
  </section>

  <section class="case-study-services">
    <div class="container case-study-services__grid">
      <div>
        <p class="case-study-services__eyebrow">
          Áreas trabalhadas
        </p>

        <h2>
          O que faz parte deste projeto.
        </h2>
      </div>

      <div class="case-study-services__list">
        {
          project.services.map((service, index) => (
            <div class="case-study-services__item">
              <span>
                {String(index + 1).padStart(2, "0")}
              </span>

              <p>
                {service}
              </p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <section class="case-study-gallery">
    <div class="container">
      <div class="case-study-gallery__header">
        <p>
          Galeria
        </p>

        <h2>
          Imagens e contexto do projeto.
        </h2>
      </div>

      <div class="case-study-gallery__grid">
        {
          project.gallery.map((item, index) => {
            const hasImage =
              typeof item === "object" &&
              Boolean(item.image);

            const label =
              typeof item === "string"
                ? item
                : item.label;

            return hasImage ? (
              <figure
                class:list={[
                  "case-study-gallery__item",
                  {
                    "case-study-gallery__item--large":
                      index === 0 ||
                      (typeof item === "object" &&
                        item.layout === "wide"),
                  },
                ]}
              >
                <div class="case-study-gallery__media">
                  <img
                    src={item.image}
                    alt={item.alt}
                    class="case-study-gallery__image"
                    loading="lazy"
                    decoding="async"
                  />
                </div>

                {label && (
                  <figcaption>
                    {label}
                  </figcaption>
                )}
              </figure>
            ) : (
              <div
                class:list={[
                  "case-study-gallery__placeholder",
                  {
                    "case-study-gallery__placeholder--large":
                      index === 0,
                  },
                ]}
              >
                <span>
                  {label}
                </span>
              </div>
            );
          })
        }
      </div>
    </div>
  </section>

  <section class="case-study-cta">
    <div class="container case-study-cta__inner">
      <div>
        <p class="case-study-cta__eyebrow">
          Próximo passo
        </p>

        <h2>
          Tem um projeto com desafios semelhantes?
        </h2>
      </div>

      <div>
        <Button href="/contactos">
          Falar sobre um projeto
        </Button>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .case-study-hero {
    background: var(--color-bg-primary);
  }

  .case-study-hero__grid {
    display: grid;
    grid-template-columns:
      minmax(0, 1.2fr)
      minmax(280px, 0.8fr);

    align-items: end;

    gap: clamp(64px, 10vw, 140px);
  }

  .case-study-hero__eyebrow,
  .case-study-detail__eyebrow,
  .case-study-services__eyebrow,
  .case-study-cta__eyebrow {
    margin-bottom: var(--space-6);

    color: var(--color-primary);

    font-size: 0.75rem;
    font-weight: 600;

    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .case-study-hero__title {
    margin-bottom: var(--space-6);

    font-size: clamp(3.5rem, 7vw, 7rem);
    line-height: 0.95;

    letter-spacing: -0.055em;
  }

  .case-study-hero__excerpt {
    max-width: 720px;

    margin-bottom: 0;

    color: var(--color-text-secondary);

    font-size: clamp(1.2rem, 2vw, 1.5rem);
  }

  .case-study-hero__meta {
    display: grid;

    gap: var(--space-6);

    padding-top: var(--space-6);

    border-top: 1px solid var(--color-border);
  }

  .case-study-hero__meta div {
    display: flex;
    justify-content: space-between;

    gap: var(--space-5);
  }

  .case-study-hero__meta span {
    color: var(--color-text-muted);

    font-size: 0.75rem;

    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .case-study-hero__meta strong {
    color: var(--color-text-primary);

    font-size: 0.9rem;
    font-weight: 500;

    text-align: right;
  }

  .case-study-visual {
    padding-top: 0;

    background: var(--color-bg-primary);
  }

  .case-study-visual__frame {
    width: 100%;

    padding: clamp(36px, 5vw, 64px);

    border: 1px solid var(--color-border);
    border-radius: var(--radius-xl);

    overflow: hidden;
  }

  .case-study-visual__frame--slate {
    background:
      linear-gradient(
        145deg,
        rgba(111, 130, 157, 0.18),
        rgba(24, 27, 31, 1)
      );
  }

  .case-study-visual__frame--stone {
    background:
      linear-gradient(
        145deg,
        rgba(181, 180, 175, 0.14),
        rgba(24, 27, 31, 1)
      );
  }

  .case-study-visual__frame--charcoal {
    background:
      linear-gradient(
        145deg,
        rgba(242, 240, 235, 0.06),
        rgba(17, 19, 21, 1)
      );
  }

  .case-study-visual__editorial {
    display: flex;
    align-items: center;
    justify-content: center;

    gap: clamp(56px, 8vw, 120px);

    width: 100%;
    max-width: 1050px;

    margin-inline: auto;
  }

  .case-study-visual__media {
    flex: 0 0 320px;

    width: 320px;
    aspect-ratio: 4 / 5;

    border: 1px solid var(--color-border-hover);
    border-radius: var(--radius-lg);

    overflow: hidden;

    background: rgba(17, 19, 21, 0.5);

    box-shadow: var(--shadow-soft);
  }

  .case-study-visual__media--landscape {
    flex: 0 1 520px;

    width: 520px;
    max-width: 52%;
    min-width: 0;
  }

  .case-study-visual__image {
    display: block;

    width: 100%;
    height: 100%;

    object-fit: cover;
    object-position: center 20%;
  }

  .case-study-visual__content {
    flex: 1 1 auto;

    min-width: 0;
    max-width: 540px;
  }

  .case-study-visual__eyebrow {
    margin-bottom: var(--space-4);

    color: var(--color-primary);

    font-size: 0.72rem;
    font-weight: 600;

    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .case-study-visual__title {
    margin-bottom: var(--space-3);

    font-size: clamp(2.6rem, 4vw, 4.4rem);
    line-height: 0.98;

    letter-spacing: -0.045em;
  }

  .case-study-visual__category {
    margin-bottom: var(--space-7);

    color: var(--color-text-muted);

    font-size: 0.78rem;
    font-weight: 600;

    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .case-study-visual__statement {
    max-width: 500px;

    margin-bottom: var(--space-7);

    color: var(--color-text-secondary);

    font-size: clamp(1.15rem, 1.8vw, 1.4rem);
    line-height: 1.55;
  }

  .case-study-visual__status {
    display: flex;
    align-items: center;
    flex-wrap: wrap;

    gap: var(--space-2);

    padding-top: var(--space-5);

    border-top: 1px solid var(--color-border);

    color: var(--color-text-muted);

    font-size: 0.72rem;
    font-weight: 600;

    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .case-study-visual__placeholder {
    display: flex;
    align-items: center;
    justify-content: center;

    width: 70%;
    min-height: 360px;

    margin-inline: auto;

    padding: var(--space-7);

    border: 1px solid var(--color-border-hover);
    border-radius: var(--radius-lg);

    background: rgba(17, 19, 21, 0.5);
  }

  .case-study-visual__placeholder span {
    font-size: clamp(2rem, 5vw, 5rem);
    font-weight: 600;

    letter-spacing: -0.05em;
    text-align: center;
  }

  .case-study-overview {
    background: var(--color-bg-secondary);
  }

  .case-study-overview__grid {
    display: grid;
    grid-template-columns:
      minmax(160px, 0.3fr)
      minmax(0, 1.7fr);

    gap: var(--space-8);
  }

  .case-study-overview__label p {
    margin: 0;

    color: var(--color-primary);

    font-size: 0.75rem;
    font-weight: 600;

    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .case-study-overview__content {
    max-width: 900px;
  }

  .case-study-overview__content h2 {
    margin-bottom: var(--space-6);
  }

  .case-study-overview__lead {
    color: var(--color-text-primary);

    font-size: clamp(1.25rem, 2vw, 1.6rem);
    line-height: 1.5;
  }

  .case-study-details {
    background: var(--color-bg-primary);
  }

  .case-study-detail {
    display: grid;
    grid-template-columns:
      72px
      minmax(0, 1fr);

    gap: var(--space-6);

    padding-block: var(--space-8);

    border-top: 1px solid var(--color-border);
  }

  .case-study-detail:last-child {
    border-bottom: 1px solid var(--color-border);
  }

  .case-study-detail__number {
    padding-top: 6px;

    color: var(--color-text-muted);

    font-size: 0.75rem;
    font-weight: 600;

    letter-spacing: 0.12em;
  }

  .case-study-detail__content {
    max-width: 900px;
  }

  .case-study-detail__content h2 {
    margin-bottom: var(--space-5);
  }

  .case-study-detail__content p:last-child {
    max-width: 720px;

    margin-bottom: 0;
  }

  .case-study-services {
    background: var(--color-bg-secondary);
  }

  .case-study-services__grid {
    display: grid;
    grid-template-columns:
      minmax(0, 0.8fr)
      minmax(0, 1.2fr);

    gap: clamp(64px, 10vw, 140px);
  }

  .case-study-services h2 {
    max-width: 680px;
  }

  .case-study-services__item {
    display: grid;
    grid-template-columns:
      56px
      minmax(0, 1fr);

    gap: var(--space-4);

    padding-block: var(--space-4);

    border-top: 1px solid var(--color-border);
  }

  .case-study-services__item:last-child {
    border-bottom: 1px solid var(--color-border);
  }

  .case-study-services__item span {
    color: var(--color-text-muted);

    font-size: 0.72rem;
    font-weight: 600;

    letter-spacing: 0.1em;
  }

  .case-study-services__item p {
    margin: 0;

    color: var(--color-text-primary);
  }

  .case-study-gallery {
    background: var(--color-bg-primary);
  }

  .case-study-gallery__header {
    margin-bottom: var(--space-8);
  }

  .case-study-gallery__header p {
    margin-bottom: var(--space-5);

    color: var(--color-primary);

    font-size: 0.75rem;
    font-weight: 600;

    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .case-study-gallery__grid {
    display: grid;
    grid-template-columns:
      repeat(2, minmax(0, 1fr));

    gap: var(--space-6);
  }

  .case-study-gallery__item {
    min-width: 0;

    margin: 0;
  }

  .case-study-gallery__item--large {
    grid-column: 1 / -1;
  }

  .case-study-gallery__media {
    width: 100%;

    border: 1px solid var(--color-border);
    border-radius: var(--radius-xl);

    overflow: hidden;

    background: var(--color-bg-secondary);
  }

  .case-study-gallery__item--large
    .case-study-gallery__media {
    aspect-ratio: 16 / 9;
  }

  .case-study-gallery__item:not(
    .case-study-gallery__item--large
  )
    .case-study-gallery__media {
    aspect-ratio: 4 / 5;
  }

  .case-study-gallery__image {
    display: block;

    width: 100%;
    height: 100%;

    object-fit: cover;

    transition:
      transform 500ms cubic-bezier(0.2, 0.8, 0.2, 1);
  }

  .case-study-gallery__item:hover
    .case-study-gallery__image {
    transform: scale(1.015);
  }

  .case-study-gallery__item figcaption {
    margin-top: var(--space-3);

    color: var(--color-text-muted);

    font-size: 0.72rem;
    font-weight: 600;

    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .case-study-gallery__placeholder {
    display: flex;
    align-items: center;
    justify-content: center;

    min-height: 420px;

    padding: var(--space-6);

    border: 1px solid var(--color-border);
    border-radius: var(--radius-xl);

    background: var(--color-bg-secondary);

    color: var(--color-text-muted);

    text-align: center;
  }

  .case-study-gallery__placeholder--large {
    grid-column: 1 / -1;

    min-height: 600px;
  }

  .case-study-cta {
    background: var(--color-primary);
  }

  .case-study-cta__inner {
    display: grid;
    grid-template-columns:
      minmax(0, 1.3fr)
      auto;

    align-items: end;

    gap: var(--space-8);
  }

  .case-study-cta__eyebrow {
    color: rgba(17, 19, 21, 0.7);
  }

  .case-study-cta h2 {
    max-width: 900px;

    margin-bottom: 0;

    color: var(--color-bg-primary);

    font-size: clamp(2.5rem, 5vw, 5rem);
    line-height: 1;

    letter-spacing: -0.045em;
  }

  .case-study-cta :global(.button--primary) {
    background: var(--color-bg-primary);
    color: var(--color-text-primary);

    border-color: var(--color-bg-primary);
  }

  .case-study-cta :global(.button--primary:hover) {
    background: transparent;
    color: var(--color-bg-primary);
  }

  @media (max-width: 900px) {
    .case-study-hero__grid,
    .case-study-overview__grid,
    .case-study-services__grid,
    .case-study-cta__inner {
      grid-template-columns: 1fr;
    }

    .case-study-visual__editorial {
      gap: var(--space-7);
    }

    .case-study-visual__media {
      flex-basis: 280px;

      width: 280px;
    }

    .case-study-gallery__grid {
      grid-template-columns: 1fr;
    }

    .case-study-gallery__item--large,
    .case-study-gallery__placeholder--large {
      grid-column: auto;
    }

    .case-study-gallery__item--large
      .case-study-gallery__media {
      aspect-ratio: 16 / 10;
    }

    .case-study-gallery__item:not(
      .case-study-gallery__item--large
    )
      .case-study-gallery__media {
      aspect-ratio: 4 / 5;
    }
  }

  @media (max-width: 700px) {
    .case-study-visual__editorial {
      flex-direction: column;

      text-align: center;
    }

    .case-study-visual__content {
      width: 100%;
    }

    .case-study-visual__status {
      justify-content: center;
    }
  }

  @media (max-width: 640px) {
    .case-study-hero__title {
      font-size: clamp(3rem, 14vw, 4.6rem);
    }

    .case-study-detail {
      grid-template-columns:
        48px
        minmax(0, 1fr);
    }

    .case-study-visual__frame {
      padding: var(--space-5);
    }

    .case-study-visual__media {
      flex-basis: auto;

      width: min(100%, 270px);
    }

    .case-study-gallery__placeholder,
    .case-study-gallery__placeholder--large {
      min-height: 300px;
    }
  }

  @media (max-width: 900px) {
    .case-study-visual__editorial--landscape {
      flex-direction: column;
      text-align: center;
    }

    .case-study-visual__media--landscape {
      flex: none;

      width: min(100%, 520px);
      max-width: 100%;
    }

    .case-study-visual__editorial--landscape
      .case-study-visual__content {
      width: 100%;
    }

    .case-study-visual__editorial--landscape
      .case-study-visual__status {
      justify-content: center;
    }
  }
</style>